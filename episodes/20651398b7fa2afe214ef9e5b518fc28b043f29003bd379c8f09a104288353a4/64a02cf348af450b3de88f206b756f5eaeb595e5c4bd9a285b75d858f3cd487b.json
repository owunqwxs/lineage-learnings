      "lines_after": 35,
      "at": 1791661164939,
      "diff": "--- a/minbpe/base.py\n+++ b/minbpe/base.py\n@@ -31,3 +31,35 @@\n-    _count_elements(counts, zip(ids, ids[1:]))\n-    return counts\n-\n+    _count_elements(counts, zip(ids, ids[1:]))\n+    return counts\n+\n+\n+def _pop_top(heap, stats):\n+    \"\"\"\n+    Training helper: heap is a lazy max-heap with exactly one (-count, pair)\n+    entry per pair of stats (plus entries of deleted pairs), where count is\n+    >= stats[pair]. This holds because during training the count of an\n+    existing pair can only decrease (a merge only creates pairs containing the\n+    new token, which are pushed once with their count after the merge).\n+    Pops every pair whose count is the maximum and returns (top, pairs);\n+    the caller pushes back the pairs it does not merge.\n+    \"\"\"\n+    from heapq import heappop, heapreplace\n+    get = stats.get\n+    top = 0\n+    cands = []\n+    while heap:\n+        c, p = heap[0]\n+        if -c < top:\n+            break\n+        cur = get(p)\n+        if cur is None:\n+            heappop(heap) # pair no longer exists\n+        elif cur != -c:\n+            heapreplace(heap, (-cur, p)) # stale count: fix it\n+        else:\n+            heappop(heap)\n+            top = cur\n+            cands.append(p)\n+    if not cands:\n+        max(stats.values()) # empty stats: raise exactly like max() did\n+    return top, cands\n+"
    }
